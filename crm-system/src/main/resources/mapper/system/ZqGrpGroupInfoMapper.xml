<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.crm.system.mapper.ZqGrpGroupInfoMapper">

    <resultMap type="com.crm.system.domain.ZqGrpGroupInfo" id="ZqGrpGroupInfoResult">
        <result property="grpId" column="GRP_ID"/>
        <result property="grpName" column="GRP_NAME"/>
        <result property="grpCode" column="GRP_CODE"/>
        <result property="hqGrpCode" column="HQ_GRP_CODE"/>
        <result property="custId" column="CUST_ID"/>
        <result property="grpLevel" column="GRP_LEVEL"/>
        <result property="grpStatus" column="GRP_STATUS"/>
        <result property="areaId" column="AREA_ID"/>
        <result property="countyId" column="COUNTY_ID"/>
        <result property="countyId2" column="COUNTY_ID2"/>
        <result property="gridId" column="GRID_ID"/>
        <result property="industryMajorKind" column="INDUSTRY_MAJOR_KIND"/>
        <result property="industrySubKind" column="INDUSTRY_SUB_KIND"/>
        <result property="industryDetailKind" column="INDUSTRY_DETAIL_KIND"/>
        <result property="busiType" column="BUSI_TYPE"/>
        <result property="grpCustType" column="GRP_CUST_TYPE"/>
        <result property="grpExpandType" column="GRP_EXPAND_TYPE"/>
        <result property="grpBusiDeptType" column="GRP_BUSI_DEPT_TYPE"/>
        <result property="provinceNewoldType" column="PROVINCE_NEWOLD_TYPE"/>
        <result property="managerId" column="MANAGER_ID"/>
        <result property="grpCreator" column="GRP_CREATOR"/>
        <result property="grpCreateTime" column="GRP_CREATE_TIME"/>
        <result property="provManagerEmpId" column="PROV_MANAGER_EMP_ID"/>
        <result property="provManagerOauser" column="PROV_MANAGER_OAUSER"/>
        <result property="provManagerName" column="PROV_MANAGER_NAME"/>
        <result property="cityManagerEmpId" column="CITY_MANAGER_EMP_ID"/>
        <result property="cityManagerOauser" column="CITY_MANAGER_OAUSER"/>
        <result property="cityManagerName" column="CITY_MANAGER_NAME"/>
        <result property="countyManagerEmpId" column="COUNTY_MANAGER_EMP_ID"/>
        <result property="countyManagerOauser" column="COUNTY_MANAGER_OAUSER"/>
        <result property="countyManagerName" column="COUNTY_MANAGER_NAME"/>
        <result property="createTime" column="CREATE_TIME"/>
        <result property="updateTime" column="UPDATE_TIME"/>
    </resultMap>

    <!-- 全表删除zqzt_grp_group_info表数据 -->
    <delete id="truncateZqGrpGroupInfo">
        TRUNCATE TABLE zqzt_grp_group_info
    </delete>

    <!-- 从grp_group_info同步数据到zqzt_grp_group_info -->
    <insert id="syncFromGrpGroupInfo">
        INSERT INTO zqzt_grp_group_info(
            GRP_ID, GRP_NAME, GRP_CODE, HQ_GRP_CODE, CUST_ID, GRP_LEVEL, GRP_STATUS,
            AREA_ID, COUNTY_ID, COUNTY_ID2, GRID_ID, INDUSTRY_MAJOR_KIND, INDUSTRY_SUB_KIND,
            INDUSTRY_DETAIL_KIND, BUSI_TYPE, GRP_CUST_TYPE, GRP_EXPAND_TYPE, GRP_BUSI_DEPT_TYPE,
            PROVINCE_NEWOLD_TYPE, MANAGER_ID, GRP_CREATOR, GRP_CREATE_TIME, CREATE_TIME, UPDATE_TIME
        )
        SELECT
            GRP_ID, GRP_NAME, GRP_CODE, ZB_CUSTOMER_ID, CUSTID, GRP_LEVEL, GRP_STAT,
            AREAID, COUNTYID, COUNTYID2, GRID_ID, INDUSTRY_MAJOR_KIND, INDUSTRY_SUB_KIND,
            INDUSTRY_DETAIL_KIND, BUSI_TYPE, GRP_CUST_TYPE1, GRP_EXPAND_TYPE, GRP_BUSI_DEPT_TYPE,
            PROVINCE_NEWOLD_TYPE, MANAGERID, CREATOR, CREATE_TIME, NOW(), NOW()
        FROM grp_group_info
        WHERE 1 = 1
    </insert>

</mapper>
