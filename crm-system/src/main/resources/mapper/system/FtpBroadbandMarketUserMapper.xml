<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.crm.system.mapper.FtpBroadbandMarketUserMapper">

    <resultMap type="com.crm.system.domain.dao.FtpBroadbandMarketUser" id="FtpBroadbandMarketUserResult">
        <result property="id" column="ID_"/>
        <result property="statCycle" column="STAT_CYCLE"/>
        <result property="marketingType" column="MARKETING_TYPE"/>
        <result property="marketingName" column="MARKETING_NAME"/>
        <result property="userMarketingId" column="USER_MARKETING_ID"/>
        <result property="areaName" column="AREA_NAME"/>
        <result property="userId" column="USER_ID"/>
        <result property="svcNum" column="SVC_NUM"/>
        <result property="countyName" column="COUNTY_NAME"/>
        <result property="openDate" column="OPEN_DATE"/>
        <result property="custKind" column="CUST_KIND"/>
        <result property="custId" column="CUST_ID"/>
        <result property="custName" column="CUST_NAME"/>
        <result property="certType" column="CERT_TYPE"/>
        <result property="isGrpKey" column="IS_GRP_KEY"/>
        <result property="custGrpId" column="CUST_GRP_ID"/>
        <result property="grpCode" column="GRP_CODE"/>
        <result property="grpName" column="GRP_NAME"/>
        <result property="servManagerId" column="SERV_MANAGER_ID"/>
        <result property="servManagerName" column="SERV_MANAGER_NAME"/>
        <result property="grpExpandType" column="GRP_EXPAND_TYPE"/>
        <result property="grpBusiDeptType" column="GRP_BUSI_DEPT_TYPE"/>
        <result property="prodId" column="PROD_ID"/>
        <result property="prodName" column="PROD_NAME"/>
        <result property="userStatus" column="USER_STATUS"/>
        <result property="hqSvcType" column="HQ_SVC_TYPE"/>
        <result property="custCountyName" column="CUST_COUNTY_NAME"/>
        <result property="developerId" column="DEVELOPER_ID"/>
        <result property="developerName" column="DEVELOPER_NAME"/>
        <result property="speed" column="SPEED"/>
        <result property="userAddr" column="USER_ADDR"/>
        <result property="cycleStartTime" column="CYCLE_START_TIME"/>
        <result property="cycleEndTime" column="CYCLE_END_TIME"/>
        <result property="cycleLength" column="CYCLE_LENGTH"/>
        <result property="cycleFee" column="CYCLE_FEE"/>
        <result property="mktProductId1" column="MKT_PRODUCT_ID_1"/>
        <result property="mktProductName1" column="MKT_PRODUCT_NAME_1"/>
        <result property="mktDiscntCode1" column="MKT_DISCNT_CODE_1"/>
        <result property="mktDiscntName1" column="MKT_DISCNT_NAME_1"/>
        <result property="mktDiscntFee1" column="MKT_DISCNT_FEE_1"/>
        <result property="mktProductId2" column="MKT_PRODUCT_ID_2"/>
        <result property="mktProductName2" column="MKT_PRODUCT_NAME_2"/>
        <result property="mktDiscntCode2" column="MKT_DISCNT_CODE_2"/>
        <result property="mktDiscntName2" column="MKT_DISCNT_NAME_2"/>
        <result property="mktDiscntFee2" column="MKT_DISCNT_FEE_2"/>
        <result property="createTime" column="CREATE_TIME"/>
        <result property="mktResult" column="MKT_RESULT"/>
        <result property="orderProduct" column="ORDER_PRODUCT"/>
        <result property="otherProductName" column="OTHER_PRODUCT_NAME"/>
    </resultMap>

    <delete id="deleteByStatCycle" parameterType="java.lang.String">
        DELETE FROM ftp_broadband_market_user
        WHERE STAT_CYCLE = #{statCycle}
    </delete>

    <!-- 公共查询条件：账期 + 集团客户 + 客户经理 + 营销类型 -->
    <sql id="userBaseWhere">
        WHERE STAT_CYCLE = #{statCycle}
          AND CUST_GRP_ID = #{custGrpId}
          AND SERV_MANAGER_ID = #{servManagerId}
          AND MARKETING_TYPE = #{marketingType}
    </sql>

    <!-- 分页查询用户明细：未填写营销结果的排在前面 -->
    <select id="selectUserPage" resultType="java.util.LinkedHashMap">
        SELECT
            ID_                AS id,
            SVC_NUM            AS svc_num,
            USER_ADDR          AS user_addr,
            MARKETING_NAME     AS marketing_name,
            PROD_NAME          AS prod_name,
            MKT_PRODUCT_NAME_1 AS mkt_product_name_1,
            MKT_DISCNT_NAME_1  AS mkt_discnt_name_1,
            MKT_PRODUCT_NAME_2 AS mkt_product_name_2,
            USER_STATUS        AS user_status,
            HQ_SVC_TYPE        AS hq_svc_type,
            DEVELOPER_NAME     AS developer_name,
            SPEED              AS speed,
            CYCLE_START_TIME   AS cycle_start_time,
            CYCLE_END_TIME     AS cycle_end_time,
            CYCLE_LENGTH       AS cycle_length,
            CYCLE_FEE          AS cycle_fee,
            MKT_RESULT         AS mkt_result,
            ORDER_PRODUCT      AS order_product,
            OTHER_PRODUCT_NAME AS other_product_name
        FROM ftp_broadband_market_user
        <include refid="userBaseWhere"/>
        <if test="mktResult != null">
            AND MKT_RESULT = #{mktResult}
        </if>
        ORDER BY MKT_RESULT ASC, ID_ ASC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="countUsers" resultType="int">
        SELECT COUNT(1) FROM ftp_broadband_market_user
        <include refid="userBaseWhere"/>
        <if test="mktResult != null">
            AND MKT_RESULT = #{mktResult}
        </if>
    </select>

    <select id="countNoResultUsers" resultType="int">
        SELECT COUNT(1) FROM ftp_broadband_market_user
        <include refid="userBaseWhere"/>
        AND MKT_RESULT IS NULL
    </select>

    <select id="countByResult" resultType="int">
        SELECT COUNT(1) FROM ftp_broadband_market_user
        <include refid="userBaseWhere"/>
        <if test="result != null and result != ''">
            AND MKT_RESULT = #{result}
        </if>
    </select>

    <!-- 按用户主键集合查可选的营销成功产品：推荐产品1/2，DISTINCT + UNION ALL（对齐老框架 getProductList） -->
    <select id="selectProductOptionsByUserIds" resultType="java.util.LinkedHashMap">
        SELECT DISTINCT MKT_PRODUCT_ID_1 AS code, MKT_PRODUCT_NAME_1 AS name
        FROM ftp_broadband_market_user
        WHERE ID_ IN
        <foreach collection="userIds" item="uid" open="(" separator="," close=")">
            #{uid}
        </foreach>
          AND MKT_PRODUCT_NAME_1 IS NOT NULL
        UNION ALL
        SELECT DISTINCT MKT_PRODUCT_ID_2, MKT_PRODUCT_NAME_2
        FROM ftp_broadband_market_user
        WHERE ID_ IN
        <foreach collection="userIds" item="uid" open="(" separator="," close=")">
            #{uid}
        </foreach>
          AND MKT_PRODUCT_NAME_2 IS NOT NULL
    </select>

    <!-- 按用户主键集合查可选营销产品（回退用）：资费/折扣产品1/2 -->
    <select id="selectDiscntOptionsByUserIds" resultType="java.util.LinkedHashMap">
        SELECT DISTINCT MKT_DISCNT_CODE_1 AS code, MKT_DISCNT_NAME_1 AS name
        FROM ftp_broadband_market_user
        WHERE ID_ IN
        <foreach collection="userIds" item="uid" open="(" separator="," close=")">
            #{uid}
        </foreach>
          AND MKT_DISCNT_NAME_1 IS NOT NULL
        UNION ALL
        SELECT DISTINCT MKT_DISCNT_CODE_2, MKT_DISCNT_NAME_2
        FROM ftp_broadband_market_user
        WHERE ID_ IN
        <foreach collection="userIds" item="uid" open="(" separator="," close=")">
            #{uid}
        </foreach>
          AND MKT_DISCNT_NAME_2 IS NOT NULL
    </select>

    <!-- 批量更新营销结果：产品与其它产品名允许置空 -->
    <update id="updateResultByIds">
        UPDATE ftp_broadband_market_user
        SET MKT_RESULT = #{result},
            ORDER_PRODUCT = #{orderProduct},
            OTHER_PRODUCT_NAME = #{otherProductName}
        WHERE ID_ IN
        <foreach collection="userIds" item="uid" open="(" separator="," close=")">
            #{uid}
        </foreach>
    </update>

</mapper>
