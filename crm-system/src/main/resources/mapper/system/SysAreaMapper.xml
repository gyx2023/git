<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.crm.system.mapper.sys.SysAreaMapper">

    <resultMap type="com.crm.system.domain.dao.sys.SysArea" id="SysAreaResult">
        <result property="id" column="id_"/>
        <result property="name" column="name_"/>
        <result property="type" column="type_"/>
        <result property="parent" column="parent_"/>
        <result property="pinyin" column="pinyin_"/>
        <result property="latlng" column="latlng_"/>
        <result property="remark" column="remark_"/>
        <result property="bssCode" column="bss_code"/>
        <result property="bssCodeParent" column="bss_code_parent"/>
        <result property="order" column="order_"/>
        <result property="zqType" column="zq_type"/>
        <result property="zbArea" column="zb_area"/>
        <result property="jtCode" column="jt_code"/>
    </resultMap>

    <select id="selectAreaJtCodeList" resultType="java.util.Map">
        SELECT
            LEFT(id_, 4) AS area_code,
            CASE
                WHEN LEFT(id_, 4) = '3300' THEN '360'
                ELSE jt_code
            END AS jt_code
        FROM sys_area
        WHERE parent_ = '330000' OR id_ = '330000'
        ORDER BY
            CASE WHEN id_ = '330000' THEN 1 ELSE 0 END,
            id_
    </select>

</mapper>
