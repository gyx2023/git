<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.crm.system.mapper.CustTRosterCustomerProvinceWriteMapper">

    <resultMap type="com.crm.system.domain.CustTRosterCustomerProvinceDo" id="CustTRosterCustomerProvinceDoResult">
        <result property="id" column="id_"/>
        <result property="majorFlag" column="major_flag"/>
        <result property="rosterCustomerId" column="roster_customer_id"/>
    </resultMap>

    <!-- 清空主库表数据 -->
    <update id="truncateTable">
        TRUNCATE TABLE cust_t_roster_customer_province
    </update>

    <!-- 批量插入到主库 -->
    <insert id="insertBatch">
        INSERT INTO cust_t_roster_customer_province (id_, major_flag, roster_customer_id)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.id}, #{item.majorFlag}, #{item.rosterCustomerId})
        </foreach>
    </insert>

</mapper>
