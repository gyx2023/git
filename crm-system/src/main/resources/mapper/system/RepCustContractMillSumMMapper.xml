<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.crm.system.mapper.RepCustContractMillSumMMapper">

    <resultMap type="com.crm.system.domain.RepCustContractMillSumM" id="RepCustContractMillSumMResult">
        <result property="id" column="id_"/>
        <result property="contractId" column="contract_id"/>
        <result property="contractErp" column="contract_erp"/>
        <result property="zdBillFee" column="zd_bill_fee"/>
        <result property="finalBillFee" column="final_bill_fee"/>
        <result property="totalBillFee" column="total_bill_fee"/>
        <result property="totalOweFee" column="total_owe_fee"/>
        <result property="createDate" column="create_date"/>
        <result property="paymentDays" column="payment_days"/>
    </resultMap>

    <!-- 批量插入 -->
    <insert id="insertBatch">
        INSERT INTO rep_cust_contract_bill_sum_m (
            contract_id,
            contract_erp,
            zd_bill_fee,
            final_bill_fee,
            total_bill_fee,
            total_owe_fee,
            create_date,
            payment_days
        )
        VALUES
        <foreach collection="list" item="item" separator=",">
            (
                #{item.contractId},
                #{item.contractErp},
                #{item.zdBillFee},
                #{item.finalBillFee},
                #{item.totalBillFee},
                #{item.totalOweFee},
                #{item.createDate},
                #{item.paymentDays}
            )
        </foreach>
    </insert>

</mapper>
