<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.crm.system.mapper.encrypt.SysFieldEncryptConfigMapper">

    <!-- 获取状态为待执行(0)或失败(3)的表名列表（去重） -->
    <select id="selectDistinctTableNamesWithPendingStatus" resultType="java.lang.String">
        SELECT TABLE_NAME 
        FROM SYS_FIELD_ENCRYPT_CONFIG 
        WHERE STATUS IN ('0', '3') 
        GROUP BY TABLE_NAME
    </select>

    <!-- 查询多字段的批次数据 -->
    <select id="selectBatchDataForMultipleFields" resultType="java.util.HashMap">
        SELECT ${selectFields}
        FROM ${tableName}
        WHERE ${whereClause}
        ORDER BY ${primaryKey} ASC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <!-- 查询多字段的总数据量 -->
    <select id="countTotalDataForMultipleFields" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM ${tableName}
        WHERE ${whereClause}
    </select>

    <!-- 校验定位字段的唯一性 -->
    <select id="validatePrimaryKeyUniqueness" resultType="java.util.HashMap">
        SELECT ${primaryKey}, count(1) as cnt
        FROM ${tableName}
        GROUP BY ${primaryKey}
        HAVING cnt > 1
        LIMIT 1
    </select>

    <!-- 动态单条更新加密字段 -->
    <update id="updateEncryptedField">
        UPDATE ${tableName}
        SET ${fieldName} = #{record.encryptedValue}
        WHERE
        <foreach collection="primaryKey.split(',')" item="key" separator=" AND ">
            ${key.trim()} = #{record[${key.trim()}]}
        </foreach>
    </update>

</mapper>
