    <!-- 查询合同收入数据列表 -->
    <select id="getContractIncomeList" resultType="com.crm.system.domain.vo.ContractIncomeExcelVo">
        SELECT
            c.contract_no AS contractNo,
            c.ict_plan_income AS ictPlanIncome,
            c.norm_date AS normDate,
            ROUND(c.norm_plan_income / 10000, 6) AS normPlanIncome,
            c.plan_cycle AS planCycle,
            ROUND(c.expect_income, 6) AS expectIncome,
            include_type.include_type_value AS includeTypeValue
        FROM
            topp_contract c
            LEFT JOIN topp_income inc ON c.id_ = inc.contract_id AND c.is_valid = '1'
            LEFT JOIN topp_opportunity oppo ON oppo.id_ = c.project_id
            LEFT JOIN tcomm_customer customer ON oppo.cust_id = customer.id_
            LEFT JOIN (
                SELECT
                    GROUP_CONCAT(concat(name_, ':', include_type_value)) AS include_type_value,
                    topp_contract_include_type_money.contract_id
                FROM
                    `topp_contract_include_type_money`
                    INNER JOIN sys_code ON topp_contract_include_type_money.include_type = sys_code.code_
                GROUP BY
                    topp_contract_include_type_money.contract_id
            ) AS include_type ON include_type.contract_id = c.id_,
            sys_org o,
            sys_area a1,
            sys_area a2,
            sys_user u1
        WHERE
            u1.org_id = o.id_
            AND o.area_id = a1.id_
            AND a1.parent_ = a2.id_
            AND oppo.cust_manager_id = u1.id_
            AND a1.id_ LIKE CONCAT(#{areaId}, '%')
        GROUP BY
            c.id_
        ORDER BY
            c.audit_time DESC
    </select>

    <!-- 导出合同统计数据 -->
    <select id="exportContractList" resultMap="ToppContractExcelVoResult">
        SELECT
            oppo.opp_code,
            oppo.opp_name,
            oppo.cust_name,
            oppo.cust_no,
            oppo.opp_type,
            oppo.opp_include_type,
            oppo.unicom_type,
            oppo.unicom_type2,
            oppo.opp_source,
            oppo.cust_manager_name,
            oppo.cust_manager_tel,
            CONCAT(a2.name_, '-', a1.name_) AS manager_area,
            o.name_ AS oname,
            c.id_ AS cid,
            c.contract_no,
            c.contract_name,
            c.contract_add_type,
            c.contract_type,
            c.total_money,
            c.zzs_sl,
            c.bh_zzs_money,
            c.income_type,
            c.sign_date,
            c.start_date,
            c.end_date,
            c.contract_cate_l1_name,
            SUBSTRING_INDEX(c.contract_cate_l2_name, '-', -1) AS contract_cate_l2_name,
            SUBSTRING_INDEX(c.contract_cate_l3_name, '-', -1) AS contract_cate_l3_name,
            c.wf_zt,
            c.df_name,
            c.cb_department,
            c.lx_department,
            c.cont_state,
            c.is_valid,
            c.contract_category,
            c.ht_sm_qdyj,
            -- 聚合计算：收入统计
            IFNULL(SUM(IF(INSTR(inc.pay_days, #{nowYear}) > 0, inc.real_income_month, 0)), 0) AS year_real_income,
            IFNULL(SUM(IF(FIND_IN_SET(#{nowYear}, inc.pay_days) > 0, inc.plan_income_month, 0)), 0) AS year_plan_income,
            IFNULL(SUM(IF(INSTR(inc.pay_days, #{lastYear}) > 0, inc.real_income_month, 0)), 0) AS last_year_real_income,
            IFNULL(SUM(IF(INSTR(inc.pay_days, #{lastYear}) > 0, inc.plan_income_month, 0)), 0) AS last_year_plan_income,
            IFNULL(SUM(inc.plan_income_month), 0) AS total_plan_income,
            IFNULL(SUM(inc.real_income_month), 0) AS total_real_income,
            IFNULL(IF(inc.pay_days = #{lastYearMonth}, inc.plan_income_month, 0), 0) AS last_month_plan_income,
            IFNULL(IF(inc.pay_days = #{lastYearMonth}, inc.real_income_month, 0), 0) AS last_month_real_income,
            IFNULL(IF(inc.pay_days = #{nowYearMonth}, inc.plan_income_month, 0), 0) AS current_month_plan_income,
            c.service_in_money,
            c.gross_profit_margin,
            c.expect_income,
            c.create_time,
            c.audit_time
        FROM
            topp_contract c
            -- 左关联：合同收入表
            LEFT JOIN topp_income inc
                ON c.id_ = inc.contract_id
                AND c.is_valid = '1'
            -- 左关联：商机表
            LEFT JOIN topp_opportunity oppo
                ON oppo.id_ = c.project_id
            -- 左关联：客户表
            LEFT JOIN tcomm_customer customer
                ON oppo.cust_id = customer.id_,
            sys_org o,
            sys_area a1,
            sys_area a2,
            sys_user u1
        WHERE
            u1.org_id = o.id_
            AND o.area_id = a1.id_
            AND a1.parent_ = a2.id_
            AND oppo.cust_manager_id = u1.id_
            AND a1.id_ LIKE CONCAT(#{areaId}, '%')
        GROUP BY c.id_
        ORDER BY c.audit_time DESC
    </select>

