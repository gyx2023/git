        <result property="performTel" column="perform_tel"/>
        <result property="isNeedPerformMoney" column="is_need_perform_money"/>
        <result property="performMoney" column="perform_money"/>
        <result property="memo" column="memo_"/>
        <result property="signDate" column="sign_date"/>
        <result property="startDate" column="start_date"/>
        <result property="endDate" column="end_date"/>
        <result property="validityTime" column="validity_time"/>
        <result property="isAutoDelay" column="is_auto_delay"/>
        <result property="delayTo" column="delay_to"/>
        <result property="createTime" column="create_time"/>
        <result property="creator" column="creator"/>
        <result property="isExpire" column="is_expire"/>
        <result property="isRemind" column="is_remind"/>
        <result property="performMoneyNum" column="perform_money_num"/>
        <result property="incomeType" column="income_type"/>
        <result property="operationType" column="operation_type"/>
        <result property="relationId" column="relation_id"/>
        <result property="status" column="status_"/>
        <result property="wfZt" column="wf_zt"/>
        <result property="dfName" column="df_name"/>
        <result property="contState" column="cont_state"/>
        <result property="cbDepartment" column="cb_department"/>
        <result property="cbUser" column="cb_user"/>
        <result property="ssDate" column="ss_date"/>
        <result property="sptgDate" column="sptg_date"/>
        <result property="contXingzhi" column="cont_xingzhi"/>
        <result property="lastSpUser" column="last_sp_user"/>
        <result property="contractAddType" column="contract_add_type"/>
        <result property="zzsSl" column="zzs_sl"/>
        <result property="bhZzsMoney" column="bh_zzs_money"/>
        <result property="lxDepartment" column="lx_department"/>
        <result property="htSmQdyj" column="ht_sm_qdyj"/>
        <result property="qdgzDate" column="qdgz_date"/>
        <result property="allInMoney" column="all_in_money"/>
        <result property="lxUser" column="lx_user"/>
