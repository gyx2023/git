        <result property="payInfo" column="pay_info"/>
    </resultMap>

    <select id="selectAllWithCleanedSpecialChars" resultMap="ToppContractResult">
        SELECT 
            id_,
            project_id,
            our_company,
            other_company,
            final_cust_name,
            contract_no,
            contract_name,
            contract_type,
            contract_currency,
            total_money,
            contract_status,
            agent_person,
            agent_department,
            perform_no,
            perform_name,
            perform_tel,
            is_need_perform_money,
            perform_money,
            memo_,
            sign_date,
            start_date,
            end_date,
            validity_time,
            is_auto_delay,
            delay_to,
            create_time,
            creator,
            is_expire,
            is_remind,
            perform_money_num,
            income_type,
            operation_type,
            relation_id,
            status_,
            wf_zt,
            df_name,
            cont_state,
            cb_department,
            cb_user,
            ss_date,
            sptg_date,
            cont_xingzhi,
            last_sp_user,
            contract_add_type,
            zzs_sl,
            bh_zzs_money,
            lx_department,
            -- 清理htSmQdyj字段的特殊字符
            REPLACE(REPLACE(REPLACE(ht_sm_qdyj, '\n', ''), '\r', ''), '\t', '') AS ht_sm_qdyj,
            qdgz_date,
            all_in_money,
            lx_user,
            service_in_money,
            gross_profit_margin,
            expect_income,
            include_type,
            contract_category,
            contract_type2,
            audit_time,
            audit_user,
            audit_status,
            is_valid,
            ict_rat,
            contract_label,
            norm_plan_income,
            ict_plan_income,
            norm_date,
            contract_cate_l1_code,
            contract_cate_l1_name,
            contract_cate_l2_code,
            contract_cate_l2_name,
            contract_cate_l3_code,
            contract_cate_l3_name,
            plan_cycle,
            pay_info
        FROM topp_contract
    </select>

</mapper>
