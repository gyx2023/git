    <select id="selectToppOpportunity" resultMap="resultOpp">

        SELECT
            op.opp_code AS `opp_code`,
            op.opp_name AS `opp_name`,
            op.cust_name AS `cust_name`,
            op.cust_no AS `cust_no`,
            ca.name_ AS `opp_source`,
            op.expect_contract_money AS `expect_contract_money`,
            cb.name_ AS `unicom_type`,
            CONCAT(
                CASE
                    WHEN a.type_ = '二级' THEN a.name_
                    WHEN a.type_ = '一级' THEN a.name_
                    ELSE IFNULL(ap.name_, a.name_)
                    END,
                '--',
                a.name_
            ) AS `area_county`,
            manage.name_ch AS `customer_manager`,
            org.name_ AS `org_name`,
            COALESCE(NULLIF(manage.relation_tel, ''), manage.name_) AS `mobile_phone`,
            cs.name_ch AS `support_manager`,
            cc.name_ AS `main_business`,
            ch.name_ as `include_business`,
            cd.name_ AS `main_product`,
            CASE
                WHEN customer.develop_flag = '01' THEN '省直拓'
                WHEN customer.develop_flag = '02' THEN '市直拓'
                WHEN customer.develop_flag = '03' THEN '县直拓'
                ELSE customer.develop_flag
                END AS `develop_property`,
            DATE_FORMAT(op.create_time, '%Y-%m-%d %H:%i:%s') AS `create_time`,
            ce.name_ AS `opp_status`,
            cf.name_ AS `phase`,
            db.name_ch AS `marker`,
            op.level_area_id AS `area_level`,
            CONCAT(
                IFNULL(lev.name_, ''),
                '--',
                IFNULL(le.name_, '')
            ) AS `marker_org`,
            DATE_FORMAT(op.dabiao_create_Time, '%Y-%m-%d %H:%i:%s') AS `mark_time`,
            DATE_FORMAT(op.audit_time, '%Y-%m-%d %H:%i:%s') AS `audit_time`,
            DATE_FORMAT(op.sign_time, '%Y-%m-%d %H:%i:%s') AS `sign_time`,
            case when op.is_valid =1 then'有效' else '无效' end AS `is_valid`
        FROM topp_opportunity op
-- 左关联支撑经理
                 LEFT JOIN sys_user cs ON cs.id_ = op.designer
-- 左关联客户经理
                 LEFT JOIN sys_user manage ON manage.id_ = op.cust_manager_id
-- 左关联所属组织（通过客户经理的组织ID）
                 LEFT JOIN sys_org org ON org.id_ = manage.org_id
-- 左关联商机来源（数据字典）
                 LEFT JOIN sys_code ca ON ca.code_ = op.opp_source AND ca.type_ = 'clue_source'
-- 左关联客户行业（数据字典）
                 LEFT JOIN sys_code cb ON cb.code_ = op.unicom_type AND cb.type_ = 'unicom_type'
-- 左关联主业务（数据字典）
                 LEFT JOIN sys_code cc ON cc.code_ = op.opp_type AND cc.type_ = 'opp_type'
-- 左关联包含业务（数据字典）
                 LEFT JOIN sys_code cd ON cd.code_ = op.product_code AND cd.type_ = 'main_product'
-- 左关联商机状态（数据字典）
                 LEFT JOIN sys_code ce ON ce.code_ = op.oppo_state AND ce.type_ = 'oppo_state'
-- 左关联商机环节（数据字典）
                 LEFT JOIN sys_code cf ON cf.code_ = op.new_opp_phase AND cf.type_ = 'new_opp_phase'
-- 左关联打标人
                 LEFT JOIN sys_user db ON db.id_ = op.dabiao_creator

                 left join sys_code ch on ch.code_=TRIM(
            TRAILING ',' FROM
            IF(
                op.opp_include_type IS NULL OR op.opp_include_type = '',
                '',
                SUBSTRING(op.opp_include_type, 2, LENGTH(op.opp_include_type) - 2)
            )
                                                   ) and ch.type_ = 'opp_type'

                 left join tcomm_customer customer on customer.id_=op.cust_id

                 LEFT JOIN sys_area a ON a.id_ = op.opp_area_id  and a.id_!='100000'
LEFT JOIN sys_area ap ON ap.id_ = a.parent_ and ap.id_!='100000'

            LEFT JOIN sys_area le ON le.id_ = op.level_area_id and le.id_!='100000'
            LEFT JOIN sys_area lev ON lev.id_ = a.parent_ and lev.id_!='100000'





        where op.is_valid=1
          and year(sign_time)>=2025

    </select>

