            CAST(op.is_bidding AS CHAR) as is_bidding,
            CAST(op.is_need_external_resources AS CHAR) as is_need_external_resources,
            CAST(op.is_have_innovate AS CHAR) as is_have_innovate,
            op.cust_no,
            op.cust_name,
            DATE_FORMAT(op.create_time, '%Y/%m/%d') as create_time,
            op.oppo_state,
            CAST(op.is_valid AS CHAR) as is_valid,
            op.cust_need,
            DATE_FORMAT(op.sign_time, '%Y/%m/%d') as sign_time,
            op.bg_type,
            op.clue_id,

            -- ==================== 客户相关字段 ====================
            cust.develop_flag,
            cust.department_code,
            unicom_type_setting.setting_str1 as customer_unicom_type,

            -- ==================== 创建人信息 ====================
            creator.name_ch as creator_name_ch,
            creator.phone as creator_phone,
            creator_area_parent.name as creator_city,
            creator_area.name as creator_district,
            creator_org.name as creator_dept,

            -- ==================== 客户经理信息 ====================
            manager.name_ch as cust_manager_name_ch,
            manager.phone as cust_manager_phone,
            manager_area_parent.name as cust_manager_city,
            manager_area.name as cust_manager_district,
            manager_org.name as cust_manager_dept,

            -- ==================== 支撑经理信息 ====================
            designer.name_ch as designer_name_ch,
            designer.phone as designer_phone,
            designer_area_parent.name as designer_city,
            designer_area.name as designer_district,
            designer_org.name as designer_dept,

            -- ==================== 投标信息 ====================
            bid.bid_body,
            bid.result as bid_result,
            DATE_FORMAT(bid.result_time, '%Y/%m/%d') as bid_result_time,
            bid.bid_money,
            bid.match_bid_money,
            DATE_FORMAT(bid.create_time, '%Y/%m/%d') as bid_create_time,

            -- ==================== 合同聚合信息（子查询） ====================
            IFNULL(contract_agg.contract_count, 0) as contract_count,
            contract_agg.contract_total_money,
            DATE_FORMAT(contract_agg.min_sign_date, '%Y/%m/%d') as contract_sign_date,
            DATE_FORMAT(contract_agg.min_start_date, '%Y/%m/%d') as contract_start_date,
            DATE_FORMAT(contract_agg.min_start_date, '%Y/%m/%d') as contract_period_start,
            DATE_FORMAT(contract_agg.max_end_date, '%Y/%m/%d') as contract_end_date

        FROM topp_opportunity op

                 -- ==================== 关联客户表 ====================
                 LEFT JOIN tcomm_customer cust ON op.cust_id = cust.id_

            -- ==================== 关联客户行业字典配置 ====================
                 LEFT JOIN sys_dict_data unicom_type_setting
                           ON cust.department_code = unicom_type_setting.dict_value
                               AND unicom_type_setting.dict_type = 'unicom_type_2'

            -- ==================== 关联创建人及其组织信息 ====================
                 LEFT JOIN sys_user creator ON op.creator = creator.id_
                 LEFT JOIN sys_org creator_org ON creator.org_id = creator_org.id_
                 LEFT JOIN sys_area creator_area ON creator_org.area_id = creator_area.id_
                 LEFT JOIN sys_area creator_area_parent ON creator_area.parent_ = creator_area_parent.id_

            -- ==================== 关联客户经理及其组织信息 ====================
                 LEFT JOIN sys_user manager ON op.cust_manager_id = manager.id_
                 LEFT JOIN sys_org manager_org ON manager.org_id = manager_org.id_
                 LEFT JOIN sys_area manager_area ON manager_org.area_id = manager_area.id_
                 LEFT JOIN sys_area manager_area_parent ON manager_area.parent_ = manager_area_parent.id_

            -- ==================== 关联支撑经理及其组织信息 ====================
                 LEFT JOIN sys_user designer ON op.designer = designer.id_
                 LEFT JOIN sys_org designer_org ON designer.org_id = designer_org.id_
                 LEFT JOIN sys_area designer_area ON designer_org.area_id = designer_area.id_
                 LEFT JOIN sys_area designer_area_parent ON designer_area.parent_ = designer_area_parent.id_

            -- ==================== 关联投标信息 ====================
                 LEFT JOIN topp_bid bid ON op.bid_id = bid.id_

            -- ==================== 关联合同聚合信息（子查询） ====================
                 LEFT JOIN (
            SELECT
                project_id,
                COUNT(*) as contract_count,
                SUM(total_money) as contract_total_money,
                MIN(sign_date) as min_sign_date,
                MIN(start_date) as min_start_date,
                MAX(end_date) as max_end_date
            FROM topp_contract
            GROUP BY project_id
        ) contract_agg ON op.id_ = contract_agg.project_id

        WHERE op.opp_area_id LIKE CONCAT(#{areaId}, '%')
        ORDER BY op.id_ DESC
    </select>

    <select id="listOpportunity" resultType="com.crm.common.core.domain.dto.OpportunityDTO">
        SELECT
            oppo.opp_code,
            oppo.opp_name,
            oppo.opp_type,
            oppo.expect_contract_money,
            oppo.contract_month,
            oppo.cust_no,
            oppo.cust_name,
            CAST(CONCAT(IFNULL(DATE_FORMAT(oppo.create_time, '%Y-%m-%d %H:%i:%s'), ''), '.0') AS CHAR) as create_time,
            oppo.oppo_state,
            a.name_ AS area_name,
            o.name_ AS org_name,
            oppo.cust_manager_name,
            oppo.cust_manager_tel
        FROM
            topp_opportunity oppo
                INNER JOIN sys_user u ON u.id_ = oppo.creator
                INNER JOIN sys_org o ON u.org_id = o.id_
                INNER JOIN sys_area a ON a.id_ = o.area_id
        WHERE
            a.id_ LIKE CONCAT(#{areaId}, '%')
        ORDER BY
            oppo.create_time DESC
    </select>


</mapper>
