    <!-- 批量查询客户经理组织机构信息  -->
    <select id="selectCustManagerOrgInfoBatch" resultType="map">
        SELECT u.id_ as userId, o.name_ as orgName
        FROM sys_user u
        LEFT JOIN sys_org o ON u.org_id = o.id_
        <where>
            <if test="userIds != null and userIds.size() > 0">
                u.id_ IN
                <foreach collection="userIds" item="userId" open="(" separator="," close=")">
                    #{userId}
                </foreach>
            </if>
        </where>
    </select>

