<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.crm.system.mapper.zbzq.SalesupBakTblBidSuboppoMapper">

    <select id="selectSignedOppoData" resultType="java.lang.String">
        SELECT replace(oppo_number,'36-','') as oppo_number
        FROM salesup_bak_tbl_bid_suboppo a
        WHERE a.status = '1'
        AND a.deleted = '0'
        AND a.oppo_number  IN
        <foreach collection="oppCodes" item="oppCode" open="(" separator="," close=")">
            CONCAT('36-', #{oppCode})
        </foreach>
    </select>

</mapper>
