<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.crm.system.mapper.GrpContractInfoMapper">

    <resultMap type="com.crm.system.domain.GrpContractInfo" id="GrpContractInfoResult">
        <result property="contractId" column="contract_id"/>
        <result property="grpId" column="grp_id"/>
        <result property="erpContractId" column="erp_contract_id"/>
        <result property="inuseContractId" column="inuse_contract_id"/>
        <result property="contractType" column="contract_type"/>
        <result property="contractName" column="contract_name"/>
        <result property="contractEffdate" column="contract_effdate"/>
        <result property="contractExpdate" column="contract_expdate"/>
        <result property="paytype" column="paytype"/>
        <result property="contractNote" column="contract_note"/>
        <result property="creator" column="creator"/>
        <result property="files" column="files"/>
        <result property="contractProperty" column="contract_property"/>
        <result property="isBidding" column="is_bidding"/>
        <result property="contractMain" column="contract_main"/>
        <result property="contractParty" column="contract_party"/>
        <result property="contractDept" column="contract_dept"/>
        <result property="contractMan" column="contract_man"/>
        <result property="contractMoney2" column="contract_money2"/>
        <result property="isFix" column="is_fix"/>
        <result property="auditDate" column="audit_date"/>
        <result property="contractPhone" column="contract_phone"/>
        <result property="contractOldnum" column="contract_oldnum"/>
        <result property="yearIncome" column="year_income"/>
        <result property="servAmount" column="serv_amount"/>
        <result property="contractMoney" column="contract_money"/>
        <result property="contractSigndate" column="contract_signdate"/>
        <result property="contractStatus" column="contract_status"/>
        <result property="contractCateL1Code" column="contract_cate_l1_code"/>
        <result property="contractCateL1Name" column="contract_cate_l1_name"/>
        <result property="contractCateL2Code" column="contract_cate_l2_code"/>
        <result property="contractCateL2Name" column="contract_cate_l2_name"/>
        <result property="contractCateL3Code" column="contract_cate_l3_code"/>
        <result property="contractCateL3Name" column="contract_cate_l3_name"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="selectGrpContractInfoVo">
        select contract_id, grp_id, erp_contract_id, inuse_contract_id, contract_type, contract_name, contract_effdate, 
               contract_expdate, paytype, contract_note, creator, files, contract_property, is_bidding, contract_main, 
               contract_party, contract_dept, contract_man, contract_money2, is_fix, audit_date, contract_phone, 
               contract_oldnum, year_income, serv_amount, contract_money, contract_signdate, contract_status, 
               contract_cate_l1_code, contract_cate_l1_name, contract_cate_l2_code, contract_cate_l2_name, 
               contract_cate_l3_code, contract_cate_l3_name, remark
        from zqzt_grp_contract_info
    </sql>

    <!-- 根据合同ID查询单条数据 -->
    <select id="selectByContractId" parameterType="string" resultMap="GrpContractInfoResult">
        <include refid="selectGrpContractInfoVo"/>
        where contract_id = #{contractId}
    </select>

    <!-- 查询所有合同数据 -->
    <select id="selectAll" resultMap="GrpContractInfoResult">
        <include refid="selectGrpContractInfoVo"/>
    </select>

    <!-- 根据集团ID查询 -->
    <select id="selectByGrpId" parameterType="long" resultMap="GrpContractInfoResult">
        <include refid="selectGrpContractInfoVo"/>
        where grp_id = #{grpId}
    </select>

    <!-- 根据合同ERP编码查询 -->
    <select id="selectByErpContractId" parameterType="string" resultMap="GrpContractInfoResult">
        <include refid="selectGrpContractInfoVo"/>
        where erp_contract_id = #{erpContractId}
    </select>

    <!-- 根据合同名称查询 -->
    <select id="selectByContractName" parameterType="string" resultMap="GrpContractInfoResult">
        <include refid="selectGrpContractInfoVo"/>
        where contract_name like CONCAT('%', #{contractName}, '%')
    </select>

    <!-- 根据合同类型查询 -->
    <select id="selectByContractType" parameterType="string" resultMap="GrpContractInfoResult">
        <include refid="selectGrpContractInfoVo"/>
        where contract_type = #{contractType}
    </select>

    <!-- 根据合同状态查询 -->
    <select id="selectByContractStatus" parameterType="string" resultMap="GrpContractInfoResult">
        <include refid="selectGrpContractInfoVo"/>
        where contract_status = #{contractStatus}
    </select>
</mapper>