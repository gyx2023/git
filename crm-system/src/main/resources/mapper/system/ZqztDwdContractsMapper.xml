            #{item.financeVatRate},
            #{item.financeUnVatAmount},
            #{item.repositoryNameUnicom},
            #{item.repositoryNameVendor},
            #{item.contractType},
            #{item.approvalDate},
            #{item.enterpertime},
            #{item.contractStartDate},
            #{item.contractEndDate},
            #{item.contractTimelimitName},
