<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.crm.system.mapper.travel.ZqztTravelNatureCustMapper">

    <update id="truncateTable">
        TRUNCATE TABLE zqzt_travel_nature_cust
    </update>

    <select id="searchByKeyword" resultType="com.crm.system.domain.dao.travel.ZqztTravelNatureCust">
        SELECT nature_cust_id, nature_cust_name
        FROM zqzt_travel_nature_cust
        WHERE nature_cust_name LIKE CONCAT('%', #{keyword}, '%')
        LIMIT 50
    </select>

</mapper>
