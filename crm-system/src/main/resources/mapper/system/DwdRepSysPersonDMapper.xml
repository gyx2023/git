<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.crm.system.mapper.DwdRepSysPersonDMapper">

    <resultMap type="com.crm.system.domain.vo.DwdRepSysPersonDVo" id="DwdRepSysPersonDResult">
        <result property="fullName" column="full_name"/>
        <result property="mobile" column="mobile"/>
        <result property="areaName" column="area_name"/>
        <result property="countyName" column="county_name"/>
    </resultMap>

    <select id="selectAreaAndCounty" resultMap="DwdRepSysPersonDResult">
        SELECT full_name,mobile, area_name,county_name FROM dwd_rep_sys_person_d WHERE
        <foreach collection="personInfos" item="info" separator=" OR " open="(" close=")">
            (full_name = #{info.fullName} AND mobile = #{info.mobile})
        </foreach>
    </select>

</mapper>
