<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.crm.system.mapper.FtpBroadbandMarketCustMapper">

    <resultMap type="com.crm.system.domain.dao.FtpBroadbandMarketCust" id="FtpBroadbandMarketCustResult">
        <result property="id" column="ID_"/>
        <result property="statCycle" column="STAT_CYCLE"/>
        <result property="custMarketingId" column="CUST_MARKETING_ID"/>
        <result property="areaName" column="AREA_NAME"/>
        <result property="countyName" column="COUNTY_NAME"/>
        <result property="custGrpId" column="CUST_GRP_ID"/>
        <result property="grpCode" column="GRP_CODE"/>
        <result property="grpName" column="GRP_NAME"/>
        <result property="servManagerId" column="SERV_MANAGER_ID"/>
        <result property="servManagerName" column="SERV_MANAGER_NAME"/>
        <result property="grpExpandType" column="GRP_EXPAND_TYPE"/>
        <result property="grpBusiDeptType" column="GRP_BUSI_DEPT_TYPE"/>
        <result property="marketingType" column="MARKETING_TYPE"/>
        <result property="marketingName" column="MARKETING_NAME"/>
        <result property="userScale" column="USER_SCALE"/>
        <result property="createTime" column="CREATE_TIME"/>
        <result property="orderId" column="ORDER_ID"/>
    </resultMap>

    <!-- 新增：根据统计周期删除数据 -->
    <delete id="deleteByStatCycle" parameterType="java.lang.String">
        DELETE FROM ftp_broadband_market_cust
        WHERE STAT_CYCLE = #{statCycle}
    </delete>

    <!-- 按主键查询客户头部信息 -->
    <select id="selectCustById" resultType="com.crm.system.domain.dao.FtpBroadbandMarketCust">
        SELECT
            ID_            AS id,
            STAT_CYCLE     AS statCycle,
            CUST_MARKETING_ID AS custMarketingId,
            AREA_NAME      AS areaName,
            COUNTY_NAME    AS countyName,
            CUST_GRP_ID    AS custGrpId,
            GRP_CODE       AS grpCode,
            GRP_NAME       AS grpName,
            SERV_MANAGER_ID   AS servManagerId,
            SERV_MANAGER_NAME AS servManagerName,
            GRP_EXPAND_TYPE   AS grpExpandType,
            GRP_BUSI_DEPT_TYPE AS grpBusiDeptType,
            MARKETING_TYPE AS marketingType,
            MARKETING_NAME AS marketingName,
            USER_SCALE     AS userScale,
            ORDER_ID       AS orderId
        FROM ftp_broadband_market_cust
        WHERE ID_ = #{id}
    </select>

</mapper>
