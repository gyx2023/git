<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.crm.system.mapper.ZqztRpaBusinessTaskRetryMapper">

    <resultMap type="ZqztRpaBusinessTaskRetryDo" id="ZqztRpaBusinessTaskRetryDoResult">
        <id property="id" column="id"/>
        <result property="retryId" column="retry_id"/>
        <result property="bizCode" column="biz_code"/>
        <result property="messageBody" column="message_body"/>
        <result property="targetUrl" column="target_url"/>
        <result property="httpMethod" column="http_method"/>
        <result property="contentType" column="content_type"/>
        <result property="headers" column="headers"/>
        <result property="noticeRecordId" column="notice_record_id"/>
        <result property="status" column="status"/>
        <result property="retryCount" column="retry_count"/>
        <result property="lastError" column="last_error"/>
        <result property="nextRetryTime" column="next_retry_time"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="selectPendingRetryTasks" resultMap="ZqztRpaBusinessTaskRetryDoResult">
        SELECT * FROM zqzt_rpa_business_task_retry
        WHERE next_retry_time &lt;= #{now}
          AND status IN (0, 1)
        ORDER BY create_time ASC
        LIMIT 100
    </select>

    <update id="updateTaskStatus">
        UPDATE zqzt_rpa_business_task_retry
        SET status = #{status},
            retry_count = #{retryCount},
            last_error = #{lastError},
            next_retry_time = #{nextRetryTime},
            update_time = NOW()
        WHERE id = #{id}
    </update>

</mapper>
