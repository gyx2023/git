<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.crm.system.mapper.SysCodeMapper">

    <resultMap type="com.crm.system.domain.SysCode" id="SysCodeResult">
        <result property="id" column="id_"/>
        <result property="name" column="name_"/>
        <result property="type" column="type_"/>
        <result property="code" column="code_"/>
        <result property="order" column="order_"/>
        <result property="remark" column="remark_"/>
        <result property="isSystem" column="is_system"/>
        <result property="settingInt1" column="setting_int1"/>
        <result property="settingInt2" column="setting_int2"/>
        <result property="settingStr1" column="setting_str1"/>
        <result property="settingStr2" column="setting_str2"/>
        <result property="settingStr3" column="setting_str3"/>
    </resultMap>

    <select id="selectAllWithCleanedSpecialChars" resultMap="SysCodeResult">
        SELECT 
            id_,
            REPLACE(REPLACE(REPLACE(name_, '\n', ''), '\r', ''), '\t', '') AS name_,
            type_,
            code_,
            order_,
            REPLACE(REPLACE(REPLACE(remark_, '\n', ''), '\r', ''), '\t', '') AS remark_,
            is_system,
            setting_int1,
            setting_int2,
            REPLACE(REPLACE(REPLACE(setting_str1, '\n', ''), '\r', ''), '\t', '') AS setting_str1,
            REPLACE(REPLACE(REPLACE(setting_str2, '\n', ''), '\r', ''), '\t', '') AS setting_str2,
            REPLACE(REPLACE(REPLACE(setting_str3, '\n', ''), '\r', ''), '\t', '') AS setting_str3
        FROM sys_code
    </select>

</mapper>
