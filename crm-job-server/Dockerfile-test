FROM huailaikxq-registry.cucloud.cn/zj_zq2025/jdk8:8u452-custom

MAINTAINER Lion Li

RUN mkdir -p /crm/server/logs \
    /crm/server/temp \
    /crm/skywalking/agent

WORKDIR /crm/server

ENV SERVER_PORT=8080 LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8

# 创建日志目录
RUN ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && echo 'Asia/Shanghai' > /etc/timezone

EXPOSE ${SERVER_PORT}

ADD ./crm-job-server/target/crm-job-server.jar ./app.jar

ENTRYPOINT ["java", \
            "-Djava.security.egd=file:/dev/./urandom", \
            "-Dserver.port=${SERVER_PORT}", \
            # 应用名称 如果想区分集群节点监控 改成不同的名称即可
#            "-Dskywalking.agent.service_name=crm-server", \
#            "-javaagent:/crm/skywalking/agent/skywalking-agent.jar", \
            "-Duser.timezone=Asia/Shanghai -Xms512m -Xmx1g -XX:MetaspaceSize=128m -XX:MaxMetaspaceSize=512m -XX:+HeapDumpOnOutOfMemoryError -XX:+PrintGCDateStamps  -XX:+PrintGCDetails -XX:NewRatio=1 -XX:SurvivorRatio=30 -XX:+UseParallelGC -XX:+UseParallelOldGC", \
            "-jar", "app.jar"]
