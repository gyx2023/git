# Spring Boot 的配置文件（默认是 properties 格式，也可以换成 application.yml）

# 服务端口，改成 9090 后就要用 http://localhost:9090/... 访问
server.port=8080

# 应用名，主要出现在日志和监控里
spring.application.name=springboot-demo

# 打印业务包的详细日志，方便你观察请求进来后走到了哪里
logging.level.com.example.demo=debug

spring.datasource.url=jdbc:mysql://127.0.0.1:3306/demo?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
spring.datasource.username=root
spring.datasource.password=改成你自己的数据库密码
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# MyBatis???????????????? Java ??????
mybatis.configuration.map-underscore-to-camel-case=true

# ? Spring ??????? schema.sql
spring.sql.init.mode=always
